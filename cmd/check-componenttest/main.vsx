// ui/componenttest checked on a small task app, the way a component's
// test is written.
package main

import (
    "image/draw"
    "ui/state"
    "ui/componenttest"
    "ui/viewport"
    "time"
    "web"
)

/// A viewport source that asks for a crosshair while the pointer moves
/// over it.
final class CrossSource: viewport.Source {
    var handle: viewport.Handle? = nil
    override init() { super.init() }
    override func Attached(h: viewport.Handle) { handle = h }
    override func PointerMove(e: dom.PointerEvent, x: float32, y: float32) { handle?.Cursor = "crosshair" }
}

var crossSource: CrossSource! = nil

var failures = 0

func check(ok: bool, what: string) {
    if ok {
        print("ok    \(what)")
    } else {
        print("FAIL  \(what)")
        failures += 1
    }
}

struct Todo {
    let ID: int
    var Title: string
    var Done: bool
}

func App() -> Element {
    let (todos, setTodos) = useState<[Todo]>([])
    let (draft, setDraft) = useState("")
    let (nextID, setNextID) = useState(1)
    return (
        <main>
            <h1>Tasks</h1>
            <form onSubmit={e in
                e.PreventDefault()
                if !draft.isEmpty {
                    setTodos(todos + [Todo(ID: nextID, Title: draft, Done: false)])
                    setNextID(nextID + 1)
                    setDraft("")
                }
            }>
                <label>New task <input placeholder="What needs doing?" value={draft} onInput={e in setDraft(e.Value)} /></label>
            </form>
            <ul>
                {todos.map { t in
                    <li key={t.ID} className={t.Done ? "done" : ""}>
                        <input type="checkbox" aria-label={"done: \(t.Title)"} checked={t.Done} onChange={
                            setTodos(todos.map { it in it.ID == t.ID ? Todo(ID: it.ID, Title: it.Title, Done: !it.Done) : it })
                        } />
                        <span>{t.Title}</span>
                    </li>
                }}
            </ul>
            <p data-testid="left">{todos.filter { !$0.Done }.count} left</p>
        </main>
    )
}

func Quantity() -> Element {
    let (qty, setQty) = useState(2)
    let (price, setPrice) = useState(1.5)
    return (
        <div>
            <input id="qty" value={"\(qty)"} onInput={e in if let n = int(e.Value) { setQty(n) } } />
            <input id="price" value={"\(price)"} onInput={e in if let p = float64(e.Value) { setPrice(p) } } />
            <p data-testid="total">{float64(qty) * price}</p>
        </div>
    )
}

func Events() -> Element {
    let (log, setLog) = useState<[string]>([])
    return (
        <div>
            <p id="card" onMouseEnter={setLog { prev in prev + ["enter"] }} onMouseLeave={setLog { prev in prev + ["leave"] }}
               onDoubleClick={setLog { prev in prev + ["double"] }} onContextMenu={e in
                   e.PreventDefault()
                   setLog { prev in prev + ["menu"] }
               }>card</p>
            <input id="name" onFocus={setLog { prev in prev + ["focus"] }} onBlur={setLog { prev in prev + ["blur"] }} />
            <button id="other">other</button>
            <p data-testid="log">{log.joined(separator: ",")}</p>
        </div>
    )
}

let Theme = createContext("light")

final class Session {
    var Name: string
    init(name: string) { Name = name }
}
let CurrentUser = createContext<Session?>(nil)

func Badge() -> Element {
    let theme = use(Theme)
    let who = use(CurrentUser)?.Name ?? "nobody"
    return <span className={"badge " + theme}>{who}</span>
}

func Themed() -> Element {
    let (open, setOpen) = useState(false)
    return (
        <div>
            <Badge />
            <Theme value="dark">
                <CurrentUser value={Session("ada")}>
                    <Badge />
                    {if open { <Badge /> }}
                    {[1, 2].map { n in <Badge key={n} /> }}
                </CurrentUser>
            </Theme>
            <button onClick={setOpen(true)}>open</button>
        </div>
    )
}

func SignIn() -> Element {
    let user = useRef<HTMLElement>(nil)
    let pass = useRef<HTMLElement>(nil)
    let (log, setLog) = useState<[string]>([])
    useEffect({
        setLog(["mounted"])
        Focus(user)
        state.OnCleanup { setLog(["cleaned"]) }
    }, [])
    return (
        <form>
            <input id="user" ref={user} />
            <input id="pass" ref={pass} type="password" />
            <button type="button" onClick={Focus(pass)}>next</button>
            <p data-testid="log">{log.joined(separator: ",")}</p>
        </form>
    )
}

func Toggle() -> Element {
    let (shown, setShown) = useState(true)
    let el = useRef<HTMLElement>(nil)
    let (ready, setReady) = useState(false)
    useEffect({
        setReady(el.current != nil)
    }, [shown])
    return (
        <div>
            {if shown { <SignIn /> }}
            {if shown { <span ref={el}>x</span> }}
            <p data-testid="ref">{ready ? "set" : "none"}</p>
            <button id="hide" onClick={setShown(false)}>hide</button>
        </div>
    )
}

func Inputs() -> Element {
    let (log, setLog) = useState<[string]>([])
    return (
        <div onClickCapture={setLog { $0 + ["capture"] }}>
            <input id="keys" onKeyUp={e in setLog { $0 + ["up " + e.Key] }}
                   onCompositionUpdate={e in setLog { $0 + ["composing " + e.Data] }} />
            <button id="press" onMouseDown={setLog { $0 + ["mousedown"] }} onMouseUp={setLog { $0 + ["mouseup"] }}
                    onMouseOver={setLog { $0 + ["over"] }} onPointerEnter={setLog { $0 + ["enter"] }}
                    onClick={setLog { $0 + ["click"] }}>press</button>
            <p data-testid="inputs">{log.joined(separator: ",")}</p>
        </div>
    )
}

struct Contact: Equatable {
    var ID: int
    var Name: string
}

@Observable final class Book {
    var Contacts: [Contact] = []
    var Draft = ""
    var next = 1

    init() {}

    func Add() {
        if Draft.isEmpty { return }
        Contacts.append(Contact(ID: next, Name: Draft))
        next += 1
        Draft = ""
    }
}

let Books = createContext<Book?>(nil)

func ContactList() -> Element {
    let book = use(Books)!
    return (
        <ul>
            {book.Contacts.map { c in <li key={c.ID}>{c.Name}</li> }}
        </ul>
    )
}

func AddContact() -> Element {
    let book = use(Books)!
    return (
        <form onSubmit={e in
            e.PreventDefault()
            book.Add()
        }>
            <input id="draft" value={book.Draft} onInput={e in book.Draft = e.Value} />
            <p data-testid="count">{book.Contacts.count} contacts</p>
        </form>
    )
}

struct NotFound: Error {}

func loadUser(id: int) async throws -> string {
    try await time.Sleep(time.Duration.Milliseconds(10))
    if id == 0 { throw NotFound() }
    return id == 1 ? "Ada" : "Grace"
}

func Profile() -> Element {
    let (id, setId) = useState(1)
    let user = state.Resource<string>(of: { id }) { n in try await loadUser(n) }
    return (
        <section>
            {switch user.State {
            case .loading: <p className="spinner">loading</p>
            case .ready(let name): <h2>{name}</h2>
            case .failed(_): <p role="alert">not found</p>
            }}
            <button id="next" onClick={setId(id + 1)}>next</button>
            <button id="none" onClick={setId(0)}>none</button>
        </section>
    )
}

// A ref on an element holding a live region and a list: given before
// the effect runs, though the region and the list are built first.
var refAtMount = "unset"
func RefAroundLive() -> Element {
    let el = useRef<HTMLElement>(nil)
    let items = [1, 2]
    useEffect({ refAtMount = el.current == nil ? "nil" : "set" }, [])
    return (
        <div tabindex="0" ref={el}>
            {items.count}
            {items.map { i in <span key={i}>{i}</span> }}
        </div>
    )
}

func AutoFocused() -> Element {
    return (
        <form>
            <input id="first" />
            <input id="second" autofocus />
        </form>
    )
}

@MainActor
func main() async -> int32 {
    // Refs, effects and Focus.
    let si = componenttest.Mount(width: 300, height: 200) { <Toggle /> }
    check(si.ByTestId("log").Text == "mounted", "an effect runs once the nodes are in, with refs set (\(si.ByTestId("log").Text))")
    check(si.Page.FocusedElement === si.Query("#user").First, "and Focus through a ref focuses the field")
    si.Click(si.Query("button[type=button]"))
    check(si.Page.FocusedElement === si.Query("#pass").First, "Focus from a handler")
    check(si.ByTestId("ref").Text == "set", "a ref is its element")
    si.Click(si.Query("#hide"))
    check(si.ByTestId("ref").Text == "none", "and nil once it is gone")

    // An @Observable store, given through a context; a field controlled by it.
    let book = Book()
    let bk = componenttest.Mount(width: 300, height: 200) {
        <Books value={book}>
            <AddContact />
            <ContactList />
        </Books>
    }
    bk.Type(into: bk.Query("#draft"), "Ada")
    check(book.Draft == "Ada", "typing writes the store's property through onInput")
    bk.Press("Enter")
    check(bk.ByRole("listitem").Text == "Ada" && bk.ByTestId("count").Text == "1 contacts",
          "a store's method updates every component that read it (\(bk.ByTestId("count").Text))")
    check(bk.Query("#draft").Value == "", "and the field it cleared")
    book.Draft = "Grace"
    book.Add()
    check(bk.ByRole("listitem").Count == 2, "a write from outside the tree shows too")

    // Context: values given down the tree, to live parts made later too.
    let t = componenttest.Mount(width: 300, height: 200) { <Themed /> }
    check(t.Query(".badge.light").Text == "nobody", "outside a Provider, a context's fallback")
    check(t.Query(".badge.dark").Count == 3 && t.Query(".badge.dark").Text == "ada", "inside, the value given, to components and list rows (\(t.Query(".badge.dark").Count))")
    t.Click(t.ByRole("button"))
    check(t.Query(".badge.dark").Count == 4, "and to a branch made later")

    // Async data: a resource's states, switched on in markup.
    let p = componenttest.Mount(width: 300, height: 200) { <Profile /> }
    check(p.Query(".spinner").Exists, "a resource shows loading first")
    check((await p.WaitFor { p.ByRole("heading") }).Text == "Ada", "then what it loaded")
    p.Click(p.Query("#next"))
    check(p.Query(".spinner").Exists, "loads again when its key changes")
    check((await p.WaitFor { p.ByText("Grace") }).Exists, "and shows the new value")
    p.Click(p.Query("#none"))
    check((await p.WaitFor { p.ByRole("alert") }).Text == "not found", "and a failure")

    // The pointer and focus events a component handles.
    let ev = componenttest.Mount(width: 300, height: 200) { <Events /> }
    ev.Hover(ev.Query("#card"))
    ev.Hover(ev.Query("#other"))
    ev.DoubleClick(ev.Query("#card"))
    ev.RightClick(ev.Query("#card"))
    ev.Click(ev.Query("#name"))
    ev.Click(ev.Query("#other"))
    check(ev.ByTestId("log").Text == "enter,leave,enter,double,menu,leave,focus,blur",
          "onMouseEnter, onMouseLeave, onDoubleClick, onContextMenu, onFocus and onBlur (\(ev.ByTestId("log").Text))")

    // keyup, the mouse events, pointerenter, capture and composition.
    let inp = componenttest.Mount(width: 300, height: 200) { <Inputs /> }
    inp.Click(inp.Query("#keys"))
    inp.Release("x")
    inp.Compose("ni")
    check(inp.ByTestId("inputs").Text == "capture,up x,composing ni", "onKeyUp, onClickCapture and onCompositionUpdate (\(inp.ByTestId("inputs").Text))")
    inp.Compose("")
    inp.Click(inp.Query("#press"))
    check(inp.ByTestId("inputs").Text.hasSuffix("over,enter,mousedown,mouseup,capture,click"),
          "onMouseOver, onPointerEnter, onMouseDown, onMouseUp, then the click, captured first (\(inp.ByTestId("inputs").Text))")

    // Numbers in controlled fields.
    let q = componenttest.Mount(width: 300, height: 120) { <Quantity /> }
    check(q.ByTestId("total").Text == "3.0", "numbers bound to fields show (\(q.ByTestId("total").Text))")
    q.Type(into: q.Query("#qty"), "0")
    check(q.ByTestId("total").Text == "30.0", "typing into a number field writes the number back (\(q.ByTestId("total").Text))")
    q.Type(into: q.Query("#qty"), "x")
    check(q.ByTestId("total").Text == "30.0", "and what does not parse leaves it (\(q.ByTestId("total").Text))")
    q.Replace(in: q.Query("#price"), "2")
    check(q.ByTestId("total").Text == "40.0", "Replace types over what a field holds (\(q.ByTestId("total").Text))")

    let css = "li.done span { text-decoration: line-through; color: rgb(150, 150, 150); }"
    let screen = componenttest.Mount(width: 420, height: 300, css: css) { <App /> }

    check(screen.ByRole("heading").Text == "Tasks", "a heading is found by its role")
    check(screen.ByLabel("New task").First?.TagName == "input", "a field by the label around it")
    screen.Type(into: screen.ByPlaceholder("What needs doing?"), "buy milk")
    screen.Press("Enter")
    screen.Type(into: screen.ByPlaceholder("What needs doing?"), "walk")
    screen.Press("Enter")
    check(screen.ByRole("listitem").Count == 2, "typing and Enter add items (\(screen.ByRole("listitem").Count))")
    check(screen.ByPlaceholder("What needs doing?").Value == "", "and clear the field")
    check(screen.ByTestId("left").Text == "2 left", "a live count follows (\(screen.ByTestId("left").Text))")

    screen.Click(screen.ByLabel("done: buy milk"))
    check(screen.ByText("buy milk").Style?.Color == draw.Color(150, 150, 150), "a done item's text takes the done style")
    check(screen.ByTestId("left").Text == "1 left", "and the count follows it")
    check(screen.ByRole("checkbox").Count == 2 && screen.ByRole("listitem").Nodes[0].HasClass("done"), "the row is the same, marked done")

    let px = screen.Pixels()
    check(px.At(2, 2) == draw.Color(255, 255, 255), "the page is drawn")
    // Recorded on the first run (delete the file to record it again);
    // run from ui/, as `vsc run check-componenttest` is.
    check(px.Matches(golden: "cmd/check-componenttest/testdata/tasks.png"), "the pixels are the golden image's")

    // An effect sees refs whatever is inside the element.
    _ = componenttest.Mount(width: 200, height: 100) { <RefAroundLive /> }
    check(refAtMount == "set", "a ref around a live region and a list is set when the effect runs (\(refAtMount))")

    // autofocus focuses its element once mounted.
    let af = componenttest.Mount(width: 200, height: 100) { <AutoFocused /> }
    check(af.Page.FocusedElement === af.Query("#second").First, "autofocus takes focus on mount")

    // Styled: a fragment carrying a sheet stays a node, so the mount sees
    // its sheet.
    let sheet = component.Sheet(package: "probe", css: "@layer probe { .probe-marker { color: red } }", after: [])
    let styled = component.Styled(sheet, component.Text("x"))
    check(styled.Nodes().count == 1 && styled.Nodes()[0] === styled, "a styled fragment is kept whole")
    var given: [string] = []
    let doc = componenttest.Mount(width: 100, height: 100) { component.Styled(sheet, <p>styled</p>) }
    given = doc.Page.ProgramStyleSheets
    check(given.contains { $0.contains("probe-marker") }, "and its sheet reaches the page")

    // A viewport source's cursor shows on the move that set it.
    crossSource = CrossSource()
    let vp = componenttest.Mount(width: 200, height: 100, css: ".v { width: 100px; height: 50px }") { viewport.Viewport(source: crossSource, class: "v") }
    _ = vp.Hover(vp.Query(".v"))
    check(vp.Page.DesiredCursor() == web.Cursor.crosshair, "a viewport source's cursor shows on the move that sets it (got \(vp.Page.DesiredCursor()))")

    if failures > 0 {
        print("\(failures) FAILED")
        return 1
    }
    print("ALL COMPONENTTEST CHECKS PASSED")
    return 0
}

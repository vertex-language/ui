package main

html, body { height: 100%; }
body { background: #111318; color: #e6e8ee; font: 13px system-ui; overflow: hidden; }
.app { display: flex; height: 100%; }
aside { width: 320px; flex: none; overflow-y: auto; padding: 12px; background: #181b22; accent-color: #6ea8ff; }
.row { display: flex; align-items: center; gap: 10px; height: 28px; }
.row span { width: 80px; }
.row input { flex: 1; }
main { flex: 1; position: relative; }
.view { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.toolbar { position: absolute; left: 16px; top: 16px; padding: 6px; border-radius: 10px; background: rgba(0, 0, 0, .55); }
.toolbar button { font: 600 13px system-ui; color: white; background: #3b6fd8; border: none; border-radius: 6px; padding: 6px 12px; }

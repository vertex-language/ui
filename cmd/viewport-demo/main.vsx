// viewport-demo: a .vsx page with a panel of sliders beside a viewport
// the program draws itself: the shape of an editor, without the editor.
// The sliders steer what the viewport draws; it animates while "Live" is
// on, and a click in it moves its marker.
//
//     vsc run viewport-demo
//     VSX_TRACE=1 VSX_QUIT_AFTER=5 vsc run viewport-demo   # what each frame costs, then quit
package main

import (
    "ui/app"
    "ui/viewport"
)

/// A gradient that scrolls while live, with a marker where it was last
/// clicked.
final class Gradient: viewport.Source {
    var hue: float32 = 0.6
    var markX: float32 = -1
    var markY: float32 = -1
    var handle: viewport.Handle? = nil

    override init() {
        super.init()
    }

    override func Attached(_ handle: viewport.Handle) {
        self.handle = handle
        handle.Cursor = "crosshair"
    }

    override func Detached() {
        handle = nil
    }

    override func PointerDown(_ e: dom.PointerEvent, x: float32, y: float32) {
        markX = x
        markY = y
        handle?.Invalidate()
    }

    func setHue(_ h: float32) {
        hue = h
        handle?.Invalidate()
    }

    override func Draw(_ f: viewport.Frame) -> [uint8] {
        let w = f.Width
        let h = f.Height
        var px = [uint8](repeating: 255, count: w * h * 4)
        let shift = (handle?.Live ?? false) ? int(f.Time * 60) : 0
        let base = uint8(int(hue * 255) & 255)
        let mx = int(markX * f.Scale)
        let my = int(markY * f.Scale)
        for y in 0..<h {
            let row = y * w * 4
            let g = uint8((y * 255 / max(1, h) + shift) & 255)
            var x = 0
            while x < w {
                let o = row + x * 4
                let marked = markX >= 0 && abs(x - mx) < 6 && abs(y - my) < 6
                px[o] = marked ? 255 : base
                px[o + 1] = marked ? 255 : g
                px[o + 2] = marked ? 255 : uint8((x * 255 / max(1, w)) & 255)
                x += 1
            }
        }
        return px
    }
}

func Demo() -> Element {
    let gradient = useMemo({ Gradient() }, [])
    let (live, setLive) = useState(true)
    var rows: [any component.Renderable] = []
    for i in 0..<40 {
        rows.append(
            <div className="row">
                <span>Slider {i + 1}</span>
                <input type="range" min="0" max="1" step="0.01" value={"\(gradient.hue)"}
                       onInput={e in gradient.setHue(float32(e.Value) ?? 0)} />
            </div>
        )
    }
    return (
        <div className="app">
            <aside>
                <button onClick={setLive(!live)}>{live ? "Live: on" : "Live: off"}</button>
                {component.Fragment(rows)}
            </aside>
            <main>
                <Viewport source={gradient} class="view" live={live} />
                <div className="toolbar"><button onClick={setLive(!live)}>Over the view: {live ? "pause" : "play"}</button></div>
            </main>
        </div>
    )
}

func main() async -> int32 {
    return await app.Run(title: "viewport-demo", width: 1100, height: 700) { <Demo /> }
}

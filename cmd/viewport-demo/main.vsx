// viewport-demo: a .vsx page with a panel of sliders beside a viewport
// the program draws itself: the shape of an editor, without the editor.
// The sliders steer what the viewport draws; it animates while "Live" is
// on.
//
//     vsc run viewport-demo
//     VSX_TRACE=1 VSX_QUIT_AFTER=5 vsc run viewport-demo   # what each frame costs, then quit
package main

import (
    "ui/app"
    "ui/viewport"
)

func Demo() -> Element {
    let hue = useRef<float32>(0.6)
    let live = useRef<bool>(true)
    let handleRef = useRef<viewport.Handle>(nil)
    var rows: [any component.Renderable] = []
    for i in 0..<40 {
        rows.append(
            <div className="row">
                <span>Slider {i + 1}</span>
                <input type="range" min="0" max="1" step="0.01" value={"\(hue.current ?? 0.6)"} onInput={e in
                    hue.current = float32(e.Value) ?? 0
                    handleRef.current?.Invalidate()
                } />
            </div>
        )
    }
    let paint: viewport.Draw = { w, h, t in
        var px = [uint8](repeating: 255, count: w * h * 4)
        let isLive = live.current ?? true
        let shift = isLive ? int(t * 60) : 0
        let base = int((hue.current ?? 0.6) * 255)
        for y in 0..<h {
            let row = y * w * 4
            let g = uint8((y * 255 / max(1, h) + shift) & 255)
            var x = 0
            while x < w {
                let o = row + x * 4
                px[o] = uint8(base)
                px[o + 1] = g
                px[o + 2] = uint8((x * 255 / max(1, w)) & 255)
                x += 1
            }
        }
        handleRef.current?.Live = isLive
        return px
    }
    return (
        <div className="app">
            <aside>
                <button onClick={
                    live.current = !(live.current ?? true)
                    handleRef.current?.Invalidate()
                }>{(live.current ?? true) ? "Live: on" : "Live: off"}</button>
                {component.Fragment(rows)}
            </aside>
            <main>
                {viewport.Viewport(class: "view", live: true, handle: { h in handleRef.current = h }, paint)}
                <div className="toolbar"><button onClick={
                    live.current = !(live.current ?? true)
                    handleRef.current?.Invalidate()
                }>Over the view: {(live.current ?? true) ? "pause" : "play"}</button></div>
            </main>
        </div>
    )
}

func main() async -> int32 {
    return await app.Run(title: "viewport-demo", width: 1100, height: 700) { <Demo /> }
}

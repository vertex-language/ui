// viewport-demo: a .vsx page with a panel of sliders beside a viewport
// the program draws itself: the shape of an editor, without the editor.
// The sliders steer what the viewport draws; it animates while "Live" is
// on, and a click in it moves its marker.
//
//     vsc run viewport-demo
//     VSX_TRACE=1 VSX_QUIT_AFTER=5 vsc run viewport-demo   # what each frame costs, then quit
package main

import (
    "gpu"
    "ui/app"
    "ui/viewport"
)

/// The gradient on the GPU: what Draw makes, a texel at a time, made
/// by a fragment shader. u[0] is the frame's width and height, the
/// scroll and the hue; u[1] the marker's place and whether there is one.
let gradientShader = """
#include <metal_stdlib>
using namespace metal;
struct Out { float4 pos [[position]]; };
vertex Out fullView(uint vid [[vertex_id]]) {
    Out o;
    o.pos = float4((vid & 1) != 0 ? 1.0 : -1.0, (vid & 2) != 0 ? -1.0 : 1.0, 0.0, 1.0);
    return o;
}
fragment float4 gradient(Out in [[stage_in]], constant float4* u [[buffer(0)]]) {
    float x = floor(in.pos.x);
    float y = floor(in.pos.y);
    if (u[1].z > 0.0 && abs(x - u[1].x) < 6.0 && abs(y - u[1].y) < 6.0) return float4(1.0);
    float g = fmod(floor(y * 255.0 / max(1.0, u[0].y)) + u[0].z, 256.0) / 255.0;
    float b = fmod(floor(x * 255.0 / max(1.0, u[0].x)), 256.0) / 255.0;
    return float4(u[0].w / 255.0, g, b, 1.0);
}
"""

/// A gradient that scrolls while live, with a marker where it was last
/// clicked. It draws on the GPU where the app has one (DrawTexture), and
/// on the CPU where it hasn't (Draw).
final class Gradient: viewport.Source {
    var hue: float32 = 0.6
    var markX: float32 = -1
    var markY: float32 = -1
    var handle: viewport.Handle? = nil
    var pipeline: gpu.RenderPipeline? = nil
    var pipelineTried = false
    var texture: gpu.Texture? = nil

    override init() {
        super.init()
    }

    override func Attached(handle: viewport.Handle) {
        self.handle = handle
        handle.Cursor = "crosshair"
    }

    override func Detached() {
        handle = nil
    }

    override func PointerDown(e: dom.PointerEvent, x: float32, y: float32) {
        markX = x
        markY = y
        handle?.Invalidate()
    }

    func setHue(h: float32) {
        hue = h
        handle?.Invalidate()
    }

    override func DrawTexture(f: viewport.Frame, device: gpu.Device) -> gpu.Texture? {
        if !pipelineTried {
            pipelineTried = true
            do {
                let lib = try gpu.Library(device: device, source: gradientShader)
                pipeline = try gpu.RenderPipeline(device: device, vertex: try lib.Function("fullView"),
                                                  fragment: try lib.Function("gradient"), gpu.PipelineDescriptor())
            } catch {
                print("viewport-demo: drawing on the CPU: \(error)")
            }
        }
        guard let p = pipeline else { return nil }
        if texture == nil || texture!.Width != f.Width || texture!.Height != f.Height {
            texture = gpu.Texture.Create(device: device, width: f.Width, height: f.Height, format: .rgba8)
        }
        guard let t = texture, let pass = gpu.RenderPass.Begin(device: device, color: t, depth: nil) else { return nil }
        let shift = (handle?.Live ?? false) ? int(f.Time * 60) : 0
        let u: [float32] = [float32(f.Width), float32(f.Height), float32(shift), float32(int(hue * 255) & 255),
                            markX * f.Scale, markY * f.Scale, markX >= 0 ? 1 : 0, 0]
        pass.SetPipeline(p)
        pass.SetViewport(x: 0, y: 0, width: float32(f.Width), height: float32(f.Height), near: 0, far: 1)
        u.withUnsafeBytes { b in pass.SetBytes(fragment: true, b.baseAddress!, count: b.count, index: 0) }
        pass.Draw(primitive: 4, start: 0, count: 4, instances: 1)
        pass.End()
        return t
    }

    override func Draw(f: viewport.Frame) -> [uint8] {
        let w = f.Width
        let h = f.Height
        var px = [uint8](repeating: 255, count: w * h * 4)
        let shift = (handle?.Live ?? false) ? int(f.Time * 60) : 0
        let base = uint8(int(hue * 255) & 255)
        let mx = int(markX * f.Scale)
        let my = int(markY * f.Scale)
        for y in 0..<h {
            let row = y * w * 4
            let g = uint8((y * 255 / max(1, h) + shift) & 255)
            var x = 0
            while x < w {
                let o = row + x * 4
                let marked = markX >= 0 && abs(x - mx) < 6 && abs(y - my) < 6
                px[o] = marked ? 255 : base
                px[o + 1] = marked ? 255 : g
                px[o + 2] = marked ? 255 : uint8((x * 255 / max(1, w)) & 255)
                x += 1
            }
        }
        return px
    }
}

func Demo() -> Element {
    let gradient = useMemo({ Gradient() }, [])
    let (live, setLive) = useState(true)
    var rows: [any component.Renderable] = []
    for i in 0..<40 {
        rows.append(
            <div className="row">
                <span>Slider {i + 1}</span>
                <input type="range" min="0" max="1" step="0.01" value={"\(gradient.hue)"}
                       onInput={e in gradient.setHue(float32(e.Value) ?? 0)} />
            </div>
        )
    }
    return (
        <div className="app">
            <aside>
                <button onClick={setLive(!live)}>{live ? "Live: on" : "Live: off"}</button>
                {component.Fragment(rows)}
            </aside>
            <main>
                <Viewport source={gradient} class="view" live={live} />
                <div className="toolbar"><button onClick={setLive(!live)}>Over the view: {live ? "pause" : "play"}</button></div>
            </main>
        </div>
    )
}

func main() async -> int32 {
    return await app.Run(title: "viewport-demo", width: 1100, height: 700) { <Demo /> }
}

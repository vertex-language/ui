// A .vsx app in a window: the RFC's counter, and a small task list with
// add, toggle, filter and clear. Every click and keystroke goes through
// the page's own events to the handlers written below; demo.vss styles it.
//
//     vsc run vsx-demo
//     vsc run vsx-demo -- --snapshot out.png
package main

import (
    "ui/app"
)

func Counter(start: int = 0) -> Element {
    let (count, setCount) = useState(start)
    return (
        <section className="card">
            <h2>Counter</h2>
            <p className="big">{count}</p>
            <div className="row">
                <button onClick={setCount(count - 1)}>−</button>
                <button className="primary" onClick={setCount(count + 1)}>Clicked {count} times</button>
                <button onClick={setCount(start)}>Reset</button>
            </div>
            <p className={count >= 10 ? "hint warn" : "hint"}>{count >= 10 ? "That's plenty." : "Click the blue button."}</p>
        </section>
    )
}

struct Todo {
    let ID: int
    var Title: string
    var Done: bool
}

enum Filter { case all, active, done }

func Tasks() -> Element {
    let (todos, setTodos) = useState<[Todo]>([
        Todo(ID: 1, Title: "Try the counter", Done: true),
        Todo(ID: 2, Title: "Add a task below", Done: false)
    ])
    let (draft, setDraft) = useState("")
    let (filter, setFilter) = useState(Filter.all)
    let (nextID, setNextID) = useState(3)

    let visible = todos.filter { t in
        switch filter {
        case .all: return true
        case .active: return !t.Done
        case .done: return t.Done
        }
    }
    let left = todos.filter { !$0.Done }.count

    return (
        <section className="card">
            <h2>Tasks</h2>
            <form onSubmit={e in
                e.PreventDefault()
                if !draft.isEmpty {
                    setTodos(todos + [Todo(ID: nextID, Title: draft, Done: false)])
                    setNextID(nextID + 1)
                    setDraft("")
                }
            }>
                <input placeholder="What needs doing? (Enter to add)" value={draft} onInput={e in setDraft(e.Value)} />
            </form>
            <ul>
                {visible.map { t in
                    <li key={t.ID} className={t.Done ? "done" : ""} onClick={
                        setTodos(todos.map { it in it.ID == t.ID ? Todo(ID: it.ID, Title: it.Title, Done: !it.Done) : it })
                    }>
                        <span className="box">{t.Done ? "✓" : ""}</span>{t.Title}
                    </li>
                }}
            </ul>
            <div className="row small">
                <span>{left} left</span>
                <button className={filter == .all ? "on" : ""} onClick={setFilter(.all)}>All</button>
                <button className={filter == .active ? "on" : ""} onClick={setFilter(.active)}>Active</button>
                <button className={filter == .done ? "on" : ""} onClick={setFilter(.done)}>Done</button>
                <button onClick={setTodos(todos.filter { !$0.Done })}>Clear done</button>
            </div>
        </section>
    )
}

func main() async -> int32 {
    return await app.Run(title: "Vertex .vsx demo", width: 520, height: 720) {
        <main>
            <Counter start={5} />
            <Tasks />
        </main>
    }
}
